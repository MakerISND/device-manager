rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSameDepartment(dept) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == dept;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             (data.department == null || (data.department is string && data.department.size() <= 256));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'user'; // Admins must be set manually or via an admin interface
      allow update: if isSignedIn() && isValidId(userId) && isAdmin() && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'department']);
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['assetNumber', 'status', 'type', 'department', 'createdAt', 'updatedAt']) &&
             data.assetNumber is string && data.assetNumber.size() <= 100 &&
             data.status in ['Available', 'In Use', 'Maintenance', 'Broken'] &&
             data.type in ['Computer', 'Printer', 'Notebook', 'Network', 'Peripheral', 'Other'] &&
             data.department is string && data.department.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             data.updatedAt is string && data.updatedAt.size() <= 40 &&
             (data.model == null || data.model is string && data.model.size() <= 100) &&
             (data.brand == null || data.brand is string && data.brand.size() <= 100) &&
             (data.serialNumber == null || data.serialNumber is string && data.serialNumber.size() <= 100) &&
             (data.acquiringNo == null || data.acquiringNo is string && data.acquiringNo.size() <= 100) &&
             (data.year == null || data.year is number) &&
             (data.subgroup == null || data.subgroup is string && data.subgroup.size() <= 100) &&
             (data.assignedUser == null || data.assignedUser is string && data.assignedUser.size() <= 100) &&
             (data.lastMaintenanceDate == null || data.lastMaintenanceDate is string && data.lastMaintenanceDate.size() <= 40);
    }

    match /assets/{assetId} {
      // Any signed in user can read assets
      allow read: if isSignedIn() && isValidId(assetId);
      
      // Admins can create and delete assets
      allow create: if isSignedIn() && isValidId(assetId) && isValidAsset(incoming()) && isAdmin();
      allow delete: if isSignedIn() && isValidId(assetId) && isAdmin();
      
      // Anyone can update status or minor fields if they are in the same department, admins can update anything
      allow update: if isSignedIn() && isValidId(assetId) && isValidAsset(incoming()) && (
        isAdmin() ||
        (isSameDepartment(existing().department) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedUser', 'lastMaintenanceDate', 'updatedAt']))
      );
    }
  }
}
